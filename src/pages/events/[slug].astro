---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDateTime, eventStatus, statusLabel } from '../../lib/content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const { title, shortDescription, poster, start, end, venue, mapUrl, contact, cancelled } = event.data;
const status = eventStatus(start, end, cancelled);
---
<Base title={title} description={shortDescription} ogImage={poster?.src}>
  <article class="py-24 md:py-32">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <header class="mx-auto max-w-[68ch]">
        <a href="/events" class="back-link font-sans text-xs font-semibold text-rust">← ಎಲ್ಲ ಕಾರ್ಯಕ್ರಮಗಳು</a>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class:list={[
            'rounded-full px-3 py-1 font-sans text-[11px] font-semibold',
            status === 'upcoming' && 'bg-leaf text-[#f1d9a2]',
            status === 'ongoing' && 'bg-gold text-ink',
            status === 'past' && 'bg-[rgba(115,103,90,.2)] text-muted',
            status === 'cancelled' && 'bg-rust text-white',
          ]}>{statusLabel[status]}</span>
        </div>
        <h1 class="mt-3 font-serif text-[clamp(28px,7.5vw,44px)] leading-[1.25] tracking-tight">{title}</h1>
        {poster && <img src={poster.src} alt={title} width={1200} height={630} class="mt-6 w-full rounded-[28px_28px_10px_10px] object-cover" loading="eager" />}
      </header>
      <div class="mx-auto mt-8 grid max-w-[68ch] gap-2.5 rounded-[28px_28px_14px_14px] border border-[rgba(126,77,52,.32)] bg-[rgba(255,255,255,.4)] p-5 font-sans text-sm md:grid-cols-2">
        <div><span class="block text-[10px] uppercase tracking-[.12em] text-muted">ಪ್ರಾರಂಭ</span>◷ {fmtDateTime(start)}</div>
        {end && <div><span class="block text-[10px] uppercase tracking-[.12em] text-muted">ಮುಕ್ತಾಯ</span>◷ {fmtDateTime(end)}</div>}
        {venue && <div><span class="block text-[10px] uppercase tracking-[.12em] text-muted">ಸ್ಥಳ</span>⌖ {venue}</div>}
        {contact && <div><span class="block text-[10px] uppercase tracking-[.12em] text-muted">ಸಂಪರ್ಕ</span>☎ {contact}</div>}
        {mapUrl && <a href={mapUrl} target="_blank" rel="noopener" class="font-semibold text-rust md:col-span-2">ನಕ್ಷೆಯಲ್ಲಿ ನೋಡಿ ↗</a>}
      </div>
      <div class="prose-kn mx-auto mt-8">
        <Content />
      </div>
    </div>
  </article>
</Base>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description: shortDescription,
  startDate: start.toISOString(),
  endDate: end?.toISOString(),
  eventStatus: cancelled ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
  location: venue ? { '@type': 'Place', name: venue } : undefined,
  inLanguage: 'kn',
})} />
