---
const links = [
  { href: '/', label: 'ಮುಖಪುಟ' },
  { href: '/about', label: 'ನಮ್ಮ ಬಗ್ಗೆ' },
  { href: '/events', label: 'ಕಾರ್ಯಕ್ರಮಗಳು' },
  { href: '/articles', label: 'ಲೇಖನಗಳು' },
  { href: '/gallery', label: 'ಚಿತ್ರಶಾಲೆ' },
];
const cta = { href: '/contact', label: 'ಸಂಪರ್ಕಿಸಿ' };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<nav id="site-nav" class="fixed inset-x-0 top-0 z-50 text-paper" aria-label="ಮುಖ್ಯ ನ್ಯಾವಿಗೇಶನ್">
  <div class="absolute inset-0 -z-10 bg-[rgba(30,43,31,.35)] backdrop-blur-md border-b border-[rgba(246,240,228,.2)] transition-[height,background-color] duration-300" data-nav-bg></div>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 md:h-[78px] md:px-6">
    <a href="/" class="brand flex items-center gap-2.5" aria-label="ಕದಳಿ ಮುಖಪುಟ">
      <span class="grid size-8 place-items-center rounded-full border border-current text-lg text-gold">ಕ</span>
      <span>
        <strong class="block font-serif text-2xl leading-none tracking-tight">ಕದಳಿ</strong>
        <small class="block font-sans text-[9px] tracking-[.1em] opacity-80">ಮಹಿಳಾ ಸಮಾಜ</small>
      </span>
    </a>
    <button id="menu-btn" class="grid size-[42px] place-items-center rounded-full border border-current text-xl md:hidden"
      aria-label="ಮೆನು ತೆರೆಯಿರಿ" aria-expanded="false" aria-controls="navlinks">☰</button>
    <div id="navlinks" class="navlinks">
      {links.map((l) => (
        <a href={l.href} class:list={['font-sans text-sm font-medium', isActive(l.href) && 'active']}>{l.label}</a>
      ))}
      <a href={cta.href} class="nav-cta font-sans text-sm font-medium">{cta.label} ↗</a>
    </div>
  </div>
</nav>
<style>
  .navlinks {
    position: absolute; top: 56px; left: 12px; right: 12px; z-index: 50;
    display: flex; flex-direction: column; padding: 6px 4px;
    background: var(--color-paper); color: var(--color-ink);
    border: 1px solid rgba(62,45,32,.18); border-radius: 8px;
    box-shadow: 0 15px 45px rgba(0,0,0,.18);
    opacity: 0; visibility: hidden; transform: translateY(-10px) scale(.98);
    transform-origin: 88% 0; pointer-events: none;
    transition: opacity .22s var(--ease-out-k), transform .22s var(--ease-out-k), visibility 0s .22s;
  }
  .navlinks.open {
    opacity: 1; visibility: visible; transform: none; pointer-events: auto;
    transition: opacity .25s var(--ease-out-k), transform .25s var(--ease-out-k);
  }
  .navlinks a { display: flex; min-height: 46px; align-items: center; padding: 12px; border-bottom: 1px solid rgba(62,45,32,.18); }
  .navlinks a.active { color: var(--color-rust); font-weight: 700; }
  .nav-cta { justify-content: center; border: 1px solid var(--color-rust); color: var(--color-rust); border-radius: 100px; margin: 8px 12px 6px; border-bottom-width: 1px; }
  body.menu-open { overflow: hidden; }
  #menu-btn[aria-expanded='true'] { transform: rotate(90deg); }
  #menu-btn { transition: transform .25s var(--ease-out-k); }
  @media (min-width: 768px) {
    .navlinks {
      position: static; flex-direction: row; align-items: center; gap: clamp(18px,3vw,40px);
      padding: 0; background: none; border: 0; box-shadow: none;
      opacity: 1; visibility: visible; transform: none; pointer-events: auto;
    }
    .navlinks a { padding: 0; min-height: 0; border: 0; opacity: .85; }
    .navlinks a.active { color: var(--color-gold2); opacity: 1; }
    .nav-cta { border: 1px solid rgba(255,255,255,.55); border-radius: 100px; padding: 10px 18px; margin: 0; color: inherit; opacity: 1; }
  }
  nav.solid [data-nav-bg] { background: rgba(31,43,32,.82); }
</style>
<script>
  const nav = document.getElementById('site-nav')!;
  const menu = document.getElementById('menu-btn') as HTMLButtonElement;
  const links = document.getElementById('navlinks')!;
  const setMenu = (open: boolean) => {
    links.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? 'ಮೆನು ಮುಚ್ಚಿರಿ' : 'ಮೆನು ತೆರೆಯಿರಿ');
    menu.textContent = open ? '×' : '☰';
  };
  menu.addEventListener('click', () => setMenu(!links.classList.contains('open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && links.classList.contains('open')) { setMenu(false); menu.focus(); }
  });
  document.addEventListener('click', (e) => {
    if (links.classList.contains('open') && !(e.target as HTMLElement).closest('#site-nav')) setMenu(false);
  });
  links.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  const solidAt = () => (matchMedia('(max-width: 767px)').matches ? 30 : innerHeight * 0.6);
  const sync = () => nav.classList.toggle('solid', scrollY > solidAt());
  addEventListener('scroll', sync, { passive: true });
  addEventListener('resize', sync, { passive: true });
  sync();
</script>
